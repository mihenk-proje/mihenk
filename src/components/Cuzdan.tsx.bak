"use client"

import { useStore } from "@/lib/store/StoreContext"
import { ArrowLeft, ArrowUpRight, ArrowDownRight, RefreshCcw } from "lucide-react"

export function Cuzdan({ onBack }: { onBack: () => void }) {
  const { state, resetToDemo } = useStore()
  const { jetonBakiyesi, bugunKazanilan } = state.kullanici

  const gunlukHedefYuzde = Math.min(100, (bugunKazanilan / 50) * 100)

  return (
    <div className="fixed inset-0 z-50 bg-page flex flex-col animate-in slide-in-from-right-full duration-300">
      <div className="flex-1 w-full max-w-2xl mx-auto flex flex-col h-full bg-card border-x border-primary/20 relative">
        
        <div className="flex items-center gap-4 p-4 border-b border-brand/20 bg-page/50">
          <button onClick={onBack} className="p-2 hover:bg-card rounded-full text-primary transition-colors" aria-label="Geri dön">
            <ArrowLeft size={24} />
          </button>
          <h2 className="font-display font-bold text-2xl text-primary tracking-tight">Cüzdan</h2>
          <div className="flex-1" />
          <button onClick={resetToDemo} className="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-primary/30 hover:bg-card text-xs text-secondary transition-colors">
            <RefreshCcw size={14} /> Demo Sıfırla
          </button>
        </div>

        <div className="overflow-y-auto flex-1 p-6">
          <div className="border border-brand/30 bg-page rounded-2xl p-8 mb-8 relative overflow-hidden flex flex-col items-center justify-center">
            <div className="absolute -right-20 -top-20 w-64 h-64 bg-brand/5 rounded-full blur-3xl" />
            
            <p className="text-secondary text-sm font-medium mb-2 z-10">Toplam Bakiye</p>
            <div className="font-mono text-6xl md:text-7xl font-bold text-brand z-10 tracking-tighter">
              {jetonBakiyesi}
            </div>
            
            <div className="w-full max-w-xs mt-8 z-10">
              <div className="flex justify-between text-xs text-secondary mb-2">
                <span>Günlük Üst Sınır</span>
                <span className="font-mono">{bugunKazanilan} / 50</span>
              </div>
              <div className="h-1.5 w-full bg-primary/10 rounded-full overflow-hidden">
                <div 
                  className="h-full bg-brand transition-all duration-1000 ease-out" 
                  style={{ width: `${gunlukHedefYuzde}%` }}
                />
              </div>
            </div>
          </div>

          <h3 className="font-display font-bold text-xl text-primary mb-4">Hareket Defteri</h3>
          
          <div className="space-y-3">
            {state.hareketler.map((hareket) => (
              <div key={hareket.id} className="flex items-center justify-between p-4 rounded-xl border border-primary/20 bg-page/50 hover:bg-page transition-colors">
                <div className="flex items-center gap-4">
                  <div className={`p-2 rounded-full ${hareket.miktar > 0 ? 'bg-success/10 text-success' : 'bg-brand/10 text-brand'}`}>
                    {hareket.miktar > 0 ? <ArrowUpRight size={20} /> : <ArrowDownRight size={20} />}
                  </div>
                  <div>
                    <p className="text-primary font-medium text-sm sm:text-base">{hareket.aciklama}</p>
                    <p className="text-secondary text-xs mt-1 font-mono">
                      {new Date(hareket.zaman).toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}
                    </p>
                  </div>
                </div>
                <div className={`font-mono text-lg font-bold ${hareket.miktar > 0 ? 'text-success' : 'text-primary'}`}>
                  {hareket.miktar > 0 ? '+' : ''}{hareket.miktar}
                </div>
              </div>
            ))}
          </div>
          
        </div>
      </div>
    </div>
  )
}
