"use client"

import { useState } from "react"
import { useStore } from "@/lib/store/StoreContext"
import { Urun } from "@/lib/store/types"
import { ArrowLeft, Clock, ShoppingBag } from "lucide-react"

export function Magaza({ onBack }: { onBack: () => void }) {
  const { state, urunSatinAl } = useStore()
  const [aktifKategori, setAktifKategori] = useState<'sureli' | 'sezonluk' | 'kalici' | 'islevsel'>('sureli')
  const [onizlemeUrun, setOnizlemeUrun] = useState<Urun | null>(null)
  const [satinAlmaMesaji, setSatinAlmaMesaji] = useState<{urunId: string, mesaj: string} | null>(null)

  const handleSatinAl = (urun: Urun) => {
    const basarili = urunSatinAl(urun)
    if (basarili) {
      setSatinAlmaMesaji({ urunId: urun.id, mesaj: 'Alındı' })
      setTimeout(() => setSatinAlmaMesaji(null), 3000)
      if (onizlemeUrun?.id === urun.id) {
        setOnizlemeUrun(null) // Önizlemeyi kapat
      }
    }
  }

  const kategoriler = [
    { id: 'sureli', label: 'Süreli' },
    { id: 'sezonluk', label: 'Sezonluk' },
    { id: 'kalici', label: 'Kalıcı' },
    { id: 'islevsel', label: 'İşlevsel' },
  ] as const

  const filtrelenmisUrunler = state.magaza.filter(u => u.kategori === aktifKategori)

  // Önizleme Modalı
  const renderOnizleme = () => {
    if (!onizlemeUrun) return null
    
    return (
      <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-page/80 backdrop-blur-sm">
        <div className="bg-card w-full max-w-md rounded-2xl  border border-brand/30 overflow-hidden" role="dialog" aria-modal="true" aria-labelledby="onizleme-baslik">
          <div className="bg-brand/10 p-4 border-b border-brand/20">
            <h3 id="onizleme-baslik" className="font-display font-bold text-brand flex items-center gap-2">
              <ShoppingBag size={20} /> Önizleme: {onizlemeUrun.ad}
            </h3>
            <p className="text-secondary text-sm mt-1">Bu bir önizlemedir. Profilinizde nasıl görüneceğini test ediyorsunuz.</p>
          </div>
          
          <div className="p-8 flex flex-col items-center justify-center bg-page relative">
            <div className={`rounded-full overflow-hidden w-24 h-24 mb-4 ${
              onizlemeUrun.efekt.tur === 'cerceve' && onizlemeUrun.efekt.deger === 'neon' ? 'ring-4 ring-green-500 ' : 
              onizlemeUrun.efekt.tur === 'cerceve' && onizlemeUrun.efekt.deger === 'elmas' ? 'ring-4 ring-blue-400' : ''
            }`}>
              <img src={state.kullanici.avatarUrl} alt="Profil" className="w-full h-full object-cover" />
            </div>
            
            <div className="flex items-center gap-1 flex-wrap justify-center text-lg">
              <span className={`font-bold ${
                onizlemeUrun.efekt.tur === 'adRengi' && onizlemeUrun.efekt.deger === 'altin' ? 'text-yellow-500' : 'text-primary'
              }`}>
                {state.kullanici.kullaniciAdi}
              </span>
              {(onizlemeUrun.efekt.tur === 'rozet' || state.kullanici.envanter.some(u => u.aktif && u.urunId.includes('rozet'))) && (
                <span className="text-yellow-500" title="Rozet">★</span>
              )}
            </div>
            
            {onizlemeUrun.efekt.tur === 'islev' && (
              <div className="mt-6 p-4 border border-brand/20 bg-brand/5 rounded-xl text-center text-primary text-sm font-medium">
                Sistem İşlevi: {onizlemeUrun.aciklama}
              </div>
            )}
          </div>
          
          <div className="p-4 bg-card border-t border-primary/20 flex gap-3">
            <button 
              onClick={() => setOnizlemeUrun(null)} 
              className="flex-1 py-3 bg-page hover:bg-page/80 border border-primary text-primary font-bold rounded-xl transition-colors"
            >
              Vazgeç
            </button>
            <button 
              onClick={() => handleSatinAl(onizlemeUrun)}
              disabled={state.kullanici.jetonBakiyesi < onizlemeUrun.fiyat}
              className="flex-1 py-3 bg-brand hover:bg-brand/90 text-[#12181A] font-bold rounded-xl disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
            >
              {state.kullanici.jetonBakiyesi < onizlemeUrun.fiyat ? 'Yetersiz Bakiye' : `Al (${onizlemeUrun.fiyat})`}
            </button>
          </div>
        </div>
      </div>
    )
  }

  return (
    <div className="fixed inset-0 z-40 bg-page flex flex-col animate-in slide-in-from-right-full duration-300">
      <div className="flex-1 w-full max-w-4xl mx-auto flex flex-col h-full bg-card border-x border-primary/20  relative">
        
        {/* Header */}
        <div className="flex items-center justify-between p-4 border-b border-brand/20 bg-page/50">
          <div className="flex items-center gap-4">
            <button onClick={onBack} className="p-2 hover:bg-card rounded-full text-primary transition-colors" aria-label="Geri dön">
              <ArrowLeft size={24} />
            </button>
            <h2 className="font-display font-bold text-2xl text-primary tracking-tight">Mağaza</h2>
          </div>
          <div className="font-mono text-xl font-bold text-brand bg-brand/10 px-4 py-1.5 rounded-lg border border-brand/20">
            {state.kullanici.jetonBakiyesi}
          </div>
        </div>

        {/* Kategoriler */}
        <div className="flex overflow-x-auto border-b border-primary/20 bg-page/30 hide-scrollbar">
          {kategoriler.map(kat => (
            <button
              key={kat.id}
              onClick={() => setAktifKategori(kat.id)}
              className={`flex-1 py-4 px-6 font-bold text-sm sm:text-base whitespace-nowrap transition-colors border-b-2 ${
                aktifKategori === kat.id ? 'border-brand text-brand' : 'border-transparent text-secondary hover:text-primary'
              }`}
            >
              {kat.label}
            </button>
          ))}
        </div>

        {/* Ürün Listesi */}
        <div className="flex-1 overflow-y-auto p-4 sm:p-6 bg-page">
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-4">
            {filtrelenmisUrunler.map(urun => {
              const bakiyeYetersiz = state.kullanici.jetonBakiyesi < urun.fiyat
              const alindiMesaji = satinAlmaMesaji?.urunId === urun.id
              const sahipMi = state.kullanici.envanter.some(u => u.urunId === urun.id && (urun.sureGun === null || u.aktif))

              return (
                <div key={urun.id} className="border border-primary/20 bg-card rounded-2xl p-5 flex flex-col hover:border-brand/40 transition-colors group">
                  <div className="flex justify-between items-start mb-2">
                    <h3 className="font-bold text-lg text-primary">{urun.ad}</h3>
                    <div className="font-mono font-bold text-brand text-lg">{urun.fiyat}</div>
                  </div>
                  
                  <p className="text-secondary text-sm mb-4 flex-1">{urun.aciklama}</p>
                  
                  {urun.sureGun && (
                    <div className="flex items-center gap-1.5 text-xs text-secondary mb-4 bg-page self-start px-2 py-1 rounded border border-primary/20 font-mono">
                      <Clock size={12} /> {urun.sureGun} gün süreyle
                    </div>
                  )}

                  <div className="flex gap-2 mt-auto pt-4 border-t border-primary/10">
                    <button 
                      onClick={() => setOnizlemeUrun(urun)}
                      className="flex-1 py-2 bg-page hover:bg-page/80 border border-primary text-primary text-sm font-bold rounded-lg transition-colors"
                    >
                      Dene
                    </button>
                    <button 
                      onClick={() => handleSatinAl(urun)}
                      disabled={bakiyeYetersiz || sahipMi || alindiMesaji}
                      className={`flex-1 py-2 text-sm font-bold rounded-lg transition-colors ${
                        alindiMesaji ? 'bg-success text-white border-success' :
                        sahipMi ? 'bg-page text-success border border-success' :
                        bakiyeYetersiz ? 'bg-page border border-primary/20 text-secondary opacity-50 cursor-not-allowed' :
                        'bg-brand hover:bg-brand/90 text-[#12181A]'
                      }`}
                      aria-live="polite"
                    >
                      {alindiMesaji ? 'Alındı' : sahipMi ? 'Sahipsin' : bakiyeYetersiz ? `Eksik: ${urun.fiyat - state.kullanici.jetonBakiyesi}` : 'Al'}
                    </button>
                  </div>
                </div>
              )
            })}
          </div>
          
          {filtrelenmisUrunler.length === 0 && (
            <div className="text-center text-secondary py-12">Bu kategoride henüz ürün bulunmuyor.</div>
          )}
        </div>
      </div>
      
      {renderOnizleme()}
    </div>
  )
}
